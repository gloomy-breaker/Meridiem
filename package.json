{
  "name": "meridiem",
  "productName": "Meridiem",
  "version": "1.0.0",
  "description": "A calm, local-first academic workspace and active-recall studio for macOS.",
  "main": "./out/main/index.js",
  "author": "gloomy-breaker",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "electron-vite build",
    "dist": "./scripts/package.sh && ./scripts/make-dmg.sh",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64",
    "postinstall": "electron-builder install-app-deps",
    "dist:mac:x64": "npm run build && electron-builder --mac dmg --x64",
    "dist:mac:universal": "npm run build && electron-builder --mac dmg --universal",
    "package": "./scripts/package.sh",
    "dmg": "./scripts/make-dmg.sh"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@earendil-works/pi-coding-agent": "^0.85.0",
    "@earendil-works/pi-server": "^0.85.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tiptap/core": "^3.31.2",
    "@tiptap/extension-hard-break": "^3.31.3",
    "@tiptap/extension-image": "^3.31.2",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-table": "^3.31.2",
    "@tiptap/extension-task-item": "^3.31.2",
    "@tiptap/extension-task-list": "^3.31.2",
    "@tiptap/extensions": "^3.31.2",
    "@tiptap/pm": "^3.31.2",
    "@tiptap/starter-kit": "^3.31.2",
    "codemirror": "^6.0.2",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "katex": "^0.18.2",
    "markdown-it": "^15.0.0",
    "markdown-it-texmath": "^1.0.0",
    "pdfjs-dist": "^6.3.289",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@emoji-mart/data": "^1.2.1",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "emojibase-data": "^17.0.0",
    "typescript": "^7.0.2",
    "unicode-emoji-json": "^0.9.0",
    "vite": "^8.2.1"
  },
  "homepage": "https://github.com/gloomy-breaker/Meridiem",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gloomy-breaker/Meridiem.git"
  }
}
